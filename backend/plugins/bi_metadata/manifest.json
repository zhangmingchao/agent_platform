  "tool_definitions": [
    {
      "name": "BiCli",
      "description": "通过受控 BI CLI 查询分析主体、事件、用户属性、事件属性和指标列表。仅支持只读 metadata 命令，参数必须以字符串数组传入；使用前应先读取 BI 元数据 Skill。",
      "parameters": {
        "description": "Agent 调用受控 BI CLI 时使用的参数实体。\n\nAttributes:\n    arguments: 不包含 `bi` 程序名的参数数组，例如\n        `[\"metadata\", \"events\", \"list\", \"--product-key\", \"app_001\"]`。",
        "properties": {
          "arguments": {
            "description": "BI CLI 参数数组，不包含可执行文件名。只支持 metadata 下的 analysis-bodies、events、user-properties、event-properties、metrics 列表命令",
            "items": {
              "type": "string"
            },
            "title": "Arguments",
            "type": "array"
          }
        },
        "required": [
          "arguments"
        ],
        "title": "BiCliInput",
        "type": "object"
      },
      "example_input": {
        "arguments": [
          "metadata",
          "events",
          "list",
          "--product-key",
          "<product_key>",
          "--page-num",
          "1",
          "--page-size",
          "50"
        ]
      },
      "output_schema": {
        "type": "object"
      },
      "risk_level": "medium"
    },
    {
      "name": "SolarEventCount",
      "description": "查询指定产品事件今天、昨天或日期范围内的总次数（条数），例如 _appEnd 今天多少条。一次调用自动获取产品时区、事件和总次数元数据，并组装报表参数；无需先搜索接口或读取大型契约。失败时返回 count=null、失败阶段及请求编号，停止本轮重复查询。未指定应用表示产品全部应用；time_type 默认服务端时间。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_key",
          "event_name"
        ],
        "properties": {
          "product_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "已确认的产品业务键，沿用当前会话明确产品"
          },
          "event_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "事件原始标识，如 _appEnd，不能填写显示名"
          },
          "date": {
            "type": "string",
            "default": "today",
            "description": "today、yesterday 或 YYYY-MM-DD，按产品时区解析自然日"
          },
          "end_date": {
            "type": "string",
            "description": "可选包含在内的末日；省略查询单日，最多31天"
          },
          "time_zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "可选 IANA 时区，例如 Asia/Shanghai；省略自动读取产品时区"
          },
          "app_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "可选实际应用数字ID；省略表示产品全部应用"
          },
          "time_type": {
            "enum": [
              "server",
              "client"
            ],
            "default": "server",
            "description": "server 服务端时间，client 客户端时间"
          }
        }
      },
      "example_input": {
        "product_key": "<product_key>",
        "event_name": "_appEnd",
        "date": "today"
      },
      "output_schema": {
        "type": "object"
      },
      "risk_level": "medium"
    },
    {
      "name": "SolarCatalog",
      "description": "搜索 BI/Rule 接口目录或读取单个接口的完整契约、前后端源码与可用性；本工具不访问线上服务。先 search 再 describe，未知/内部接口不能假设可调用。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "search",
              "describe"
            ],
            "default": "search"
          },
          "endpoint_id": {
            "type": "string"
          },
          "search": {
            "type": "string",
            "default": ""
          },
          "service": {
            "enum": [
              "all",
              "bi",
              "rule"
            ],
            "default": "all"
          },
          "module": {
            "type": "string",
            "default": ""
          },
          "operation": {
            "enum": [
              "all",
              "read",
              "write",
              "internal",
              "special",
              "unverified"
            ],
            "default": "all"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        },
        "required": []
      },
      "example_input": {
        "action": "search",
        "service": "bi",
        "search": "event",
        "operation": "read",
        "offset": 0,
        "limit": 20
      },
      "output_schema": {
        "type": "object"
      },
      "risk_level": "medium"
    },
    {
      "name": "SolarQuery",
      "description": "执行目录中 operation=read 的 BI/Rule 接口，包括 POST 分析查询和实验报告。请先通过 SolarCatalog.describe 获取参数契约；用户未明确产品、应用、日期和时区时不得猜测。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endpoint_id": {
            "type": "string",
            "description": "SolarCatalog 返回的完整接口 ID，必须先读取 describe 契约"
          },
          "product_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "明确的产品标识，同时作为 pk 请求头；不等于 appId"
          },
          "query": {
            "type": "object",
            "default": {},
            "description": "按 query_schema 填写的 URL 查询参数，保留数字和数组类型"
          },
          "body": {
            "default": null,
            "description": "按 body_schema 填写的 JSON 请求体；没有请求体的接口使用 null"
          },
          "path": {
            "type": "object",
            "default": {},
            "description": "目录中声明的路径占位参数，通常为空"
          },
          "context": {
            "type": "object",
            "default": {},
            "additionalProperties": false,
            "description": "前端业务上下文，不能传入认证或租户请求头",
            "properties": {
              "app_ids": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxItems": 200
              },
              "all_apps": {
                "type": "boolean"
              },
              "language": {
                "enum": [
                  "zh",
                  "en"
                ]
              },
              "time_zone": {
                "type": "string",
                "maxLength": 80
              },
              "system_type": {
                "enum": [
                  "product",
                  "app"
                ]
              },
              "country_region": {
                "type": "string",
                "maxLength": 20
              }
            }
          }
        },
        "required": [
          "endpoint_id",
          "product_key"
        ]
      },
      "example_input": {
        "endpoint_id": "bi.get.eventConfig_findByProductKey.44438962",
        "product_key": "<product_key>",
        "query": {
          "pageNum": 1,
          "pageSize": 50
        },
        "body": null,
        "path": {},
        "context": {}
      },
      "output_schema": {
        "type": "object"
      },
      "risk_level": "medium"
    },
    {
      "name": "SolarMutate",
      "description": "执行目录中 operation=write 的明确业务操作，例如新增、编辑、上线、下线或删除；GET 也可能写入。必须有用户明确业务指令，插件配置 allow_mutations=true，并遵守 Agent 工具权限；先查询对象与执行前置检查，修改超时不得直接重试。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endpoint_id": {
            "type": "string",
            "description": "SolarCatalog 返回的完整接口 ID，必须先读取 describe 契约"
          },
          "product_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "明确的产品标识，同时作为 pk 请求头；不等于 appId"
          },
          "query": {
            "type": "object",
            "default": {},
            "description": "按 query_schema 填写的 URL 查询参数，保留数字和数组类型"
          },
          "body": {
            "default": null,
            "description": "按 body_schema 填写的 JSON 请求体；没有请求体的接口使用 null"
          },
          "path": {
            "type": "object",
            "default": {},
            "description": "目录中声明的路径占位参数，通常为空"
          },
          "context": {
            "type": "object",
            "default": {},
            "additionalProperties": false,
            "description": "前端业务上下文，不能传入认证或租户请求头",
            "properties": {
              "app_ids": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "maxItems": 200
              },
              "all_apps": {
                "type": "boolean"
              },
              "language": {
                "enum": [
                  "zh",
                  "en"
                ]
              },
              "time_zone": {
                "type": "string",
                "maxLength": 80
              },
              "system_type": {
                "enum": [
                  "product",
                  "app"
                ]
              },
              "country_region": {
                "type": "string",
                "maxLength": 20
              }
            }
          },
          "change_reason": {
            "type": "string",
            "minLength": 1,
            "description": "用户请求的修改意图及目标说明；该字段本身不是用户授权凭证"
          }
        },
        "required": [
          "endpoint_id",
          "product_key",
          "change_reason"
        ]
      },
      "example_input": {
        "endpoint_id": "<从目录选择修改接口>",
        "product_key": "<product_key>",
        "query": {},
        "body": null,
        "path": {},
        "context": {},
        "change_reason": "<用户明确要求的业务变更>"
      },
      "output_schema": {
        "type": "object"
      },
      "risk_level": "high"
    }
  ],
  "timeout_seconds": 90,
  "file_input_parameter": null,
